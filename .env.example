# Copy to .env (next to package.json) and fill in. .env is git-ignored — never commit it.
# One .env serves both servers (api-server and student-api read the same file).

# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/drivetotube
PORT=5000                      # admin API (api-server)
STUDENT_API_PORT=5001          # student API (student-api); falls back to PORT if unset
# LOG_LEVEL=info

# ── Google OAuth (two accounts, one OAuth app) ───────────────────────────────
# Client ID/Secret identify the OAuth app; only the refresh token differs per account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# YouTube channel owner. Scope: https://www.googleapis.com/auth/youtube
GOOGLE_OAUTH_REFRESH_TOKEN=
# Account that owns the Meet recordings in Drive. Scope: https://www.googleapis.com/auth/drive
# Leave empty to reuse the YouTube token (single-account setup).
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=

# ── Pipeline worker ──────────────────────────────────────────────────────────
WORKER_TICK_MS=600000          # scan/upload/reconcile every 10 min (default 60000)

# ── Meet folder housekeeping (see docs/operations.md) ────────────────────────
# Folder that collects "<meeting-code> - YYYY/MM/DD" subfolders. Daily job is off while this is unset.
DRIVE_CONSOLIDATE_TARGET_FOLDER_ID=
# Both are dry-run (log only) unless "true".
DRIVE_CONSOLIDATE_APPLY=false
DRIVE_CLEANUP_APPLY=false      # moves emptied top-level folders to the Drive trash (recoverable)
# MEET_MOVE_LOG=               # default: ./meet-moves.jsonl in the api-server working directory

# ── Student portal (student-api) ─────────────────────────────────────────────
JWT_SECRET=                    # required; long random string
INVITE_CODE=                   # fallback registration code; the one set in the admin UI wins
# CORS_ORIGIN=https://hidaya-portal.vercel.app    # comma-separated; allow-all if unset

# ── Frontend build-time (Vercel / local) ─────────────────────────────────────
# VITE_APP_MODE=student                            # build the student portal instead of the admin app
# VITE_API_URL=https://gdrive-youtube-sync.onrender.com
# API_PORT=5000                                    # dev proxy target for /api
